NODE_ENV=production
PORT={{ backend_port }}
MONGO_URI=mongodb://{{ mongo_app_user }}:{{ mongo_app_password }}@{{ hostvars[groups['database'][0]].private_ip }}:27017/{{ mongo_db_name }}?authSource={{ mongo_db_name }}
CORS_ORIGIN=http://{{ hostvars[groups['web'][0]].public_ip }}
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
TRUST_PROXY=1
