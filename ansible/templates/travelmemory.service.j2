[Unit]
Description=TravelMemory MERN API (Node.js/Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ application_base }}/backend
EnvironmentFile=/etc/travelmemory/backend.env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{ application_base }}/backend/uploads
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
